# Copy to .env.local to use it (Vite reads .env.local; .env.example is only a template).
#
# Background alerts (beta): the address of the push Worker (see push-worker/). Leave it out and the "Background
# alerts" section is hidden. It is read when the app is BUILT, so changing it means rebuilding (or, on Vercel,
# redeploying). Use https, except http://localhost:8787 for a local `wrangler dev`.
# VITE_PUSH_WORKER_URL=https://session-clock-push.YOUR-SUBDOMAIN.workers.dev
