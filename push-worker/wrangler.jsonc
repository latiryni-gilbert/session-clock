{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "session-clock-push",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Served at https://session-clock-push.<your-account-subdomain>.workers.dev
  "workers_dev": true,
  // No account ID or secrets here: the deploy gets CLOUDFLARE_ACCOUNT_ID and CLOUDFLARE_API_TOKEN
  // from environment variables. GIT_COMMIT_SHA below is only the local/default value; the deploy
  // workflow overrides it with the real commit (wrangler deploy --var GIT_COMMIT_SHA:<sha>).
  "vars": {
    "GIT_COMMIT_SHA": "dev",
    // Web Push (VAPID) identity. Both are public: the browser needs the public key to subscribe.
    "VAPID_PUBLIC_KEY": "BNwrDo_4rqZSEExYbpQeGAL_ZxSY-eITMuB_LKhMOO5NA3CCVylt5AxQbVbI1bfIXYC8A8gGeJWrmxbGvTjnKwQ",
    "VAPID_SUBJECT": "https://sessionclock.vercel.app",
    // How many alerts one scheduler run sends. 3 is safe on the free plan's 10 ms of CPU per run (see README.md).
    // On a paid plan raise it (up to 20, the cap in src/constants.ts); a number below 1 or not a number means 3.
    "MAX_PUSHES_PER_RUN": "3"
  },
  // The scheduler. The first runs every minute and sends due alerts; the second runs at 03:17 UTC for the daily
  // clean-up and must equal DAILY_CRON in src/constants.ts. (The free plan allows 5 cron triggers per account.)
  "triggers": {
    "crons": ["* * * * *", "17 3 * * *"]
  },
  // Keep the scheduler's one log line per run in the dashboard (Workers Logs). Invocation logs stay off: they
  // would record every request, including client IP addresses, and this Worker's own logging is all counts.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false }
  },
  // The matching private key is a Cloudflare secret, never a file: `wrangler secret put VAPID_PRIVATE_KEY`.
  // Deploys keep it. (For `wrangler dev`, put a local pair in .dev.vars, which git ignores; see README.md.)
  "secrets": {
    "required": ["VAPID_PRIVATE_KEY"]
  },
  // The D1 database. The ID identifies the database; it is not a credential.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "session-clock-push",
      "database_id": "20ee2d5d-e52f-496d-98dc-6f3579bf9891",
      "migrations_dir": "migrations"
    }
  ],
  // Rate limits (Workers Rate Limiting). Counters are kept per Cloudflare location, and the period must be 10 or 60.
  // The numbers are explained in README.md; keep RETRY_AFTER_SECONDS in src/constants.ts equal to the period.
  "ratelimits": [
    // POST /subscribe, per client IP.
    { "name": "SUBSCRIBE_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    // Every PUT /schedule, per client IP: bounds reads and CPU, including for unchanged uploads.
    { "name": "SCHEDULE_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    // PUT /schedule uploads that actually change something, per subscription id: bounds D1 writes.
    { "name": "SCHEDULE_CHANGE_LIMITER", "namespace_id": "1003", "simple": { "limit": 2, "period": 60 } },
    // POST /test-push: one test notification a minute per subscription, and a ceiling per client IP.
    { "name": "TEST_PUSH_LIMITER", "namespace_id": "1004", "simple": { "limit": 1, "period": 60 } },
    { "name": "TEST_PUSH_IP_LIMITER", "namespace_id": "1005", "simple": { "limit": 10, "period": 60 } }
  ]
}
